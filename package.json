{
  "private": true,
  "repository": "https://github.com/bagaar/velvet-thunder",
  "license": "MIT",
  "author": "Bagaar",
  "scripts": {
    "build": "pnpm --filter velvet-thunder build",
    "lint": "pnpm --filter '*' lint",
    "lint:fix": "pnpm --filter '*' lint:fix",
    "prepare": "pnpm build",
    "start": "concurrently 'npm:start:*' --restart-after 5000 --prefix-colors cyan,white,yellow",
    "start:addon": "pnpm --filter velvet-thunder start --no-watch.clearScreen",
    "start:test-app": "pnpm --filter test-app start",
    "start:website": "pnpm --filter website start",
    "test": "pnpm --filter '*' test"
  },
  "devDependencies": {
    "@glint/core": "1.5.2",
    "concurrently": "10.0.6",
    "prettier": "3.9.10",
    "prettier-plugin-ember-template-tag": "2.1.8",
    "release-plan": "0.18.0"
  },
  "volta": {
    "node": "24.22.2",
    "pnpm": "11.28.10"
  },
  "changelog": {
    "ignoreCommitters": []
  },
  "pnpm": {
    "overrides": {
      "@ember/test-waiters": "4.1.2",
      "@glimmer/component": "2.2.1",
      "postcss": "8.5.30"
    }
  }
}
